{
  "description": "Lightweight safeguards for this technical-assessment repository.",
  "hooks": {
    "SessionStart": [{
      "matcher": "startup|resume|compact",
      "hooks": [{
        "type": "command",
        "command": "/usr/bin/env python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/session_start.py\"",
        "statusMessage": "Loading assessment context",
        "timeout": 3,
        "additionalContextLimit": 300
      }]
    }],
    "PreToolUse": [{
      "matcher": "^Bash$",
      "hooks": [{
        "type": "command",
        "command": "/usr/bin/env python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/destructive_command_guard.py\"",
        "statusMessage": "Checking destructive command policy",
        "timeout": 3
      }]
    }]
  }
}
